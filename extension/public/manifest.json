{
  "manifest_version": 3,
  "name": "Veil — Hybrid AI PII Masking Side Panel",
  "version": "1.1.0",
  "description": "Gemini Nano masks names, IBANs, IDs and API keys locally before Firebase AI Logic reasons on placeholders in any browser tab.",
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://firebasevertexai.googleapis.com/*",
    "https://firebase.googleapis.com/*",
    "https://firebaseremoteconfig.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://content-firebaseappcheck.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Veil Hybrid Shield",
    "default_icon": {
      "16": "icons/veil-16.png",
      "48": "icons/veil-48.png",
      "128": "icons/veil-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/veil-16.png",
    "48": "icons/veil-48.png",
    "128": "icons/veil-128.png"
  }
}
