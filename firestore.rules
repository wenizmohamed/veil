rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A receipt proves what happened without storing what was said:
    // counts per category and where each step ran. No free text is accepted.
    match /users/{uid}/receipts/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'task', 'counts', 'masked', 'detector', 'reasoner', 'outboundChars', 'leakGuard', 'unknownTokens'])
        && request.resource.data.task in ['reply', 'summary', 'actions', 'formal', 'arabic']
        && request.resource.data.counts is map
        && request.resource.data.counts.keys().hasOnly(['PERSON', 'ORG', 'EMAIL', 'PHONE', 'ADDRESS', 'ID', 'ACCOUNT', 'MONEY', 'SECRET', 'DATE'])
        && request.resource.data.masked is int
        && request.resource.data.detector in ['on_device', 'rules_only']
        && request.resource.data.reasoner in ['in_cloud', 'on_device']
        && request.resource.data.outboundChars is int
        && request.resource.data.leakGuard == 'pass'
        && request.resource.data.unknownTokens is int
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
